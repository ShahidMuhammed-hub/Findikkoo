# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret used to sign session tokens on the Express server.
JWT_SECRET="unscroll-dev-session-secret-change-in-production"

# MONGODB_URI: Optional external MongoDB connection string (falls back to local persistent JSON datastore in /data).
MONGODB_URI=""

# STORAGE_CONFIGURATION: Optional object storage endpoint for uploaded project files.
STORAGE_CONFIGURATION="local-disk"
